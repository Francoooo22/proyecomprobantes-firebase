rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esSupervisor(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.rol == 'supervisor';
    }

    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if esSupervisor(request.auth.uid);
    }

    match /comprobantes/{doc} {
      allow read: if request.auth != null
        && (resource.data.vendedor_uid == request.auth.uid
            || esSupervisor(request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.vendedor_uid == request.auth.uid;
      allow update: if request.auth != null
        && (esSupervisor(request.auth.uid)
            || (request.resource.data.vendedor_uid == request.auth.uid
                && !('estado' in request.resource.data.diff(resource.data))
                && !('vendedor_uid' in request.resource.data.diff(resource.data))));
      allow delete: if esSupervisor(request.auth.uid);
    }
  }
}
